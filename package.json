{
  "name": "schema-org-mcp",
  "version": "1.1.0",
  "description": "MCP server for schema.org vocabulary - provides tools for exploring types, properties, generating JSON-LD examples, and validating structured data",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "schema-org-mcp": "./dist/index.js"
  },
  "scripts": {
    "prebuild": "node scripts/generate-build-info.js",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "verify": "npx tsx scripts/verify-deployment.ts",
    "qa": "npx tsx scripts/qa-checklist.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "schema.org",
    "structured-data",
    "json-ld",
    "seo",
    "semantic-web",
    "linked-data",
    "claude",
    "anthropic"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "axios": "^1.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/schema-org-mcp"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
